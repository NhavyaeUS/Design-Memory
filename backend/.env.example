# Design Memory — environment variables
# Copy this file to .env and fill in any values you want to override.
# .env is listed in .gitignore and will never be committed.

# Absolute or relative path to the SQLite database file.
# Relative paths are resolved from the backend/ directory.
# Default: ../data/design_memory.db  (next to the backend folder, ignored by git)
# DATABASE_URL=sqlite:///../data/design_memory.db

# Set to "development" locally. Used for logging verbosity.
# ENV=development
